# App Configuration
APP_ENV=development
APP_PORT=8080
APP_NAME=mergiate-core

# Database Configuration (PostgreSQL 17)
DB_HOST=localhost
DB_PORT=5434
DB_USER=mergiate
DB_PASSWORD=mergiate_password
DB_NAME=mergiate_core
DB_SSLMODE=disable
DB_MAX_CONNS=15
DB_MIN_CONNS=3

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT & Authentication
JWT_SECRET=mergiate-insecure-secret-key-change-in-production
JWT_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=50

# gRPC M2M Server
GRPC_ENABLED=true
GRPC_PORT=50051

